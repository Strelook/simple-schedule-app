# Зависимости (тяжелые папки, которые всегда загружаются заново)
node_modules/
.pnp
.pnp.js

# Сборка (результат работы Vite, генерируется автоматически)
dist/
build/

# Логи ошибок (нужны только локально при отладке)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Локальные переменные окружения (содержат секретные ключи, пароли и API-токены)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Системные файлы (создаются операционной системой или редакторами кода)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
